// osgovt.com on Cloudflare Workers with static assets (free).
// Deployed by .github/workflows/deploy.yml after CI passes on main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osgovt-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": { "SITE_URL": "https://osgovt.com" },
  "routes": [
    { "pattern": "osgovt.com", "custom_domain": true },
    { "pattern": "www.osgovt.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
